{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@ppt/*": ["src/ppt/*"],
      "@shared/*": ["src/shared/*"],
      "@design-system": ["src/design-system/index.ts"],
      "@design-system/*": ["src/design-system/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*.ts",
    "src/agent/**/*.ts",
    "src/ppt/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/design-system/**/*.ts",
    // Pure helpers still living in renderer that node/vitest imports directly
    "src/renderer/src/components/project-store.ts",
    "src/renderer/src/components/chat-scroll-controller.ts",
    "src/renderer/src/components/usage-trend-axis.ts",
    "src/renderer/src/components/run-process/process-model.ts",
    "src/renderer/src/components/markdown/**/*.ts",
    "src/renderer/src/app/chatMessageRuntime.ts",
    "src/renderer/src/app/userUiTheme.ts",
    "src/renderer/src/app/uiTypography.ts",
    "src/renderer/src/app/project/projectFileMutations.ts",
    "src/renderer/src/app/agent/agentRunFailure.ts",
    "src/renderer/src/app/agent/agentRunPreparation.ts",
    "src/renderer/src/app/presentation/exportExpectations.ts",
    "tests/**/*.ts"
  ]
}
