# Developer diagnostics only.
# Model credentials, endpoints, timeout, and fallback belong in Settings → 模型 / 工作流.
AGENT_LOG_LEVEL=info
# Development defaults to <project>/logs; packaged app defaults to <app-data>/logs.
# AGENT_LOG_DIR=E:/diagnostics/agent-ppt/logs
# AGENT_LOG_FILE=false
# AGENT_LOG_DETAIL=minimal
# Persist full model request/response payloads under logs/gateway (default on).
# AGENT_GATEWAY_IO_LOG=false

# Advanced development / integration overrides (optional):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AGENT_TIMEOUT_MS=600000
# AGENT_MAX_OUTPUT_TOKENS=16384
# AGENT_CONTEXT_TOKEN_THRESHOLD=100000

# Web search (optional; can also be configured in Settings → 生成参数):
# TAVILY_API_KEY=
# TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
