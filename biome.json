{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,css}",
      "scripts/check-agent-boundaries.mjs",
      "scripts/workspace-build.mjs",
      "scripts/verify-harness-package.mjs",
      "packages/harness/build.mjs",
      "packages/logs/build.mjs",
      "scripts/check-logs-boundaries.mjs",
      "scripts/verify-logs-package.mjs",
      "packages/models/build.mjs",
      "scripts/check-models-boundaries.mjs",
      "scripts/verify-models-package.mjs",
      "packages/tools/build.mjs",
      "scripts/check-tools-boundaries.mjs",
      "scripts/verify-tools-package.mjs",
      "tests/fixtures/general-agent-reliability-entry.mjs",
      "scripts/check-cli-boundaries.mjs",
      "scripts/check-ui-boundaries.mjs",
      "scripts/run-agent.mjs",
      "packages/configuration/build.mjs",
      "cli/build.mjs",
      "tests/fixtures/node-cli-entry.mjs",
      "!**/node_modules",
      "!**/dist",
      "!**/out",
      "!**/coverage",
      "!**/.vite",
      "!**/.tmp",
      "!**/.tmp-*",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "warn",
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "useIterableCallbackReturn": "off",
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "warn",
        "noArrayIndexKey": "warn",
        "noDuplicateProperties": "warn"
      },
      "complexity": {
        "noForEach": "off",
        "noImportantStyles": "off",
        "noStaticOnlyClass": "off",
        "useOptionalChain": "warn"
      },
      "a11y": {
        "recommended": false
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnsafeOptionalChaining": "warn",
        "noUnsafeFinally": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "app/**", "cli/**", "!app/main/agent-configuration/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/agent-configuration/**",
                      "@main/agent-configuration/**",
                      "!**/agent-configuration/desktop-configuration",
                      "!**/agent-configuration/ipc"
                    ],
                    "message": "Use the configuration package; only the named desktop composition and IPC adapters are application entry points."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/tools/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/main/**",
                      "**/app/**",
                      "**/cli/**",
                      "@main/**",
                      "electron",
                      "electron/**",
                      "**/shared/**",
                      "@shared/**",
                      "**/ppt/**",
                      "@ppt/**",
                      "**/renderer/**",
                      "**/design-system/**",
                      "@design-system",
                      "@design-system/**"
                    ],
                    "message": "基础工具只能依赖通用执行协议和自身实现，不能依赖宿主或业务领域。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/renderer/src/components/Button.tsx",
        "app/renderer/src/components/Field.tsx",
        "app/renderer/src/components/Switch.tsx",
        "app/renderer/src/components/Select.tsx",
        "app/renderer/src/components/Menu.tsx",
        "app/renderer/src/components/Dialog.tsx",
        "app/renderer/src/components/Tabs.tsx",
        "app/renderer/src/components/PreviewNavigation.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noPositiveTabindex": "error",
            "useAriaActivedescendantWithTabindex": "error",
            "useAriaPropsForRole": "error",
            "useButtonType": "error",
            "useValidAriaProps": "error",
            "useValidAriaRole": "error",
            "useValidAriaValues": "error"
          }
        }
      }
    },
    {
      "includes": ["tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "useYield": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
