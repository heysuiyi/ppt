{
  "name": "agent-harness",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/harness",
    "packages/logs",
    "packages/models",
    "packages/tools"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/start-electron.mjs dev",
    "agent:dev": "node scripts/run-agent.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/start-electron.mjs preview",
    "build:harness": "npm run build --workspace @agent-harness/core",
    "build:logs": "npm run build --workspace @agent-harness/logs",
    "build:models": "npm run build:harness && npm run build:logs && npm run build --workspace @agent-harness/models",
    "verify:models-package": "npm run build:packages && node scripts/verify-models-package.mjs",
    "build:tools": "npm run build:harness && npm run build:logs && npm run build --workspace @agent-harness/tools",
    "verify:tools-package": "npm run build:packages && node scripts/verify-tools-package.mjs",
    "build:packages": "npm run build --workspaces",
    "verify:logs-package": "npm run build:logs && node scripts/verify-logs-package.mjs",
    "verify:harness-package": "npm run build:harness && node scripts/verify-harness-package.mjs",
    "check:agent-boundaries": "npm run build:packages && node scripts/check-agent-boundaries.mjs && node scripts/check-logs-boundaries.mjs && node scripts/check-models-boundaries.mjs && node scripts/check-tools-boundaries.mjs",
    "typecheck": "npm run check:agent-boundaries && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run build:packages && vitest run --exclude tests/*.integration.test.ts",
    "test:integration:agent": "npm run build:packages && vitest run tests/agent-gateway.integration.test.ts tests/agent-loop.integration.test.ts",
    "test:integration:harness": "npm run build:packages && vitest run tests/general-agent-development-cli.integration.test.ts tests/mimo-development-cli.integration.test.ts",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@agent-harness/core": "0.1.0",
    "@agent-harness/logs": "0.1.0",
    "@agent-harness/models": "0.1.0",
    "@agent-harness/tools": "0.1.0",
    "@anthropic-ai/sdk": "^0.104.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@incremark/core": "1.0.2",
    "jszip": "^3.10.1",
    "mdast-util-to-hast": "13.2.1",
    "openai": "^6.42.0",
    "pptxgenjs": "^4.0.1",
    "proper-lockfile": "^4.1.2",
    "property-information": "7.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@electron-toolkit/preload": "^3.0.2",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^43.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.agent-ppt.app",
    "productName": "Agent PPT",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/@agent-harness/core{,/**/*}",
      "!node_modules/@agent-harness/logs{,/**/*}",
      "!node_modules/@agent-harness/models{,/**/*}",
      "!node_modules/@agent-harness/tools{,/**/*}",
      {
        "from": "packages/harness",
        "to": "node_modules/@agent-harness/core",
        "filter": [
          "package.json",
          "dist/**/*.js",
          "dist/**/*.d.ts"
        ]
      },
      {
        "from": "packages/logs",
        "to": "node_modules/@agent-harness/logs",
        "filter": [
          "package.json",
          "dist/**/*.js",
          "dist/**/*.d.ts"
        ]
      },
      {
        "from": "packages/models",
        "to": "node_modules/@agent-harness/models",
        "filter": [
          "package.json",
          "dist/**/*.js",
          "dist/**/*.d.ts"
        ]
      },
      {
        "from": "packages/tools",
        "to": "node_modules/@agent-harness/tools",
        "filter": [
          "package.json",
          "dist/**/*.js",
          "dist/**/*.d.ts"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.icns",
        "to": "icon.icns"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true
  }
}
