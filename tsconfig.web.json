{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@ppt/*": ["src/ppt/*"],
      "@shared/*": ["src/shared/*"],
      "@design-system": ["src/design-system/index.ts"],
      "@design-system/*": ["src/design-system/*"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/shared/**/*.ts",
    "src/models/mimo-token-plan-cn-contract.ts",
    "src/agent/model/model-contract.ts",
    "src/agent/protocol-values.ts",
    "src/logs/log-contract.ts",
    "src/design-system/**/*.ts"
  ]
}
